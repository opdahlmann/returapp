# Kopieres til backend/.env (brukes av både `dotnet run` og docker compose). Aldri i git.
# Appen skriver aldri til lokal disk: alle filer ligger i MongoDB, dev-SMS/e-post går til logg.

# MongoDB (dev-database på annen server – lim inn tilkoblingsstreng)
Mongo__ConnectionString=mongodb://user:pass@host:27017/?authSource=admin
Mongo__Database=returapp_dev

# JWT
Jwt__Secret=<min 32 tilfeldige tegn>
Jwt__Issuer=returapp
Jwt__AccessMinutes=15
Jwt__RefreshDays=30

# SMS: Console (dev, logger koden) | Twilio
Sms__Provider=Console
Sms__From=Returapp
Twilio__AccountSid=
Twilio__AuthToken=

# E-post: Console (dev, logger e-posten) | Smtp
Mail__Provider=Console
Mail__From=noreply@returapp.no
Smtp__Host=
Smtp__Port=587
Smtp__User=
Smtp__Pass=

# Web Push (genereres i fase 9: dotnet run --project src/Returapp.Api -- vapid)
Push__PublicKey=
Push__PrivateKey=
Push__Subject=mailto:drift@returapp.no

# App
App__BaseUrl=http://localhost:4200
App__Cors=http://localhost:4200
App__SeedDemo=true
App__Co2Factor=0.9

# Tester (valgfritt): egen testdatabase i stedet for Mongo i Docker. Databasen DROPPES ved hver testkjøring.
# TEST_MONGO=mongodb://user:pass@host:27017/returapp_test?authSource=admin
