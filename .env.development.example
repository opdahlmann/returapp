# Lokal kjøring: kopieres til .env.development i repo-roten (gitignorert), leses av API-et når
# ASPNETCORE_ENVIRONMENT=Development. I Dokploy settes de samme nøklene i Environment-feltet (se DEPLOY.md).
# Porten (5080) står i launchSettings.json, ikke her – i container setter Dockerfilen 8080.
# Appen skriver aldri til lokal disk: alle filer ligger i MongoDB, dev-SMS/e-post går til logg.

# MongoDB (dev-database på annen server – lim inn tilkoblingsstreng)
Mongo__ConnectionString=mongodb://user:pass@host:27017/?authSource=admin
Mongo__Database=returapp_dev

# JWT
Jwt__Secret=<min 32 tilfeldige tegn>

# SMS: Console (dev, logger koden) | Twilio
Sms__Provider=Console
Sms__From=Returapp
Twilio__AccountSid=
Twilio__AuthToken=

# E-post: Console (dev, logger e-posten) | Smtp
Mail__Provider=Console
Mail__From=noreply@returapp.no
Smtp__Host=
Smtp__Port=587
Smtp__User=
Smtp__Pass=

# Web Push: Console (dev, logger) | WebPush. Nøkler: dotnet run --project backend/src/Returapp.Api -- vapid
Push__Provider=Console
Push__PublicKey=
Push__PrivateKey=
Push__Subject=mailto:drift@returapp.no

# App
App__BaseUrl=http://localhost:4200
App__SeedDemo=true
# Innloggingsforsøk per IP per minutt (standard 30). Høyere lokalt så e2e-suiten ikke stoppes.
App__AuthRateLimitPerMinute=1000
# /api/dev/last-sms og /api/dev/last-mail (leser OTP-koder) – ALDRI true på en offentlig server
App__DevEndpoints=true

# Tester (dotnet test) bruker samme fil og samme database. De oppretter aldri egne databaser.
