---
// Ordmerket: «Retur» i tekstfargen og «app» i grønt. På mørk flis blir «app» lys grønn.
interface Props { storrelse?: number }
const { storrelse = 22 } = Astro.props;
---

<span class="ordmerke" style={`font-size:${storrelse}px`}>Retur<em>app</em></span>

<style>
  .ordmerke { font-weight: 700; letter-spacing: -.04em; line-height: 1; }
  .ordmerke em { font-style: normal; color: var(--pri); }
  :global(.mork) .ordmerke em { color: var(--mork-aksent); }
</style>
