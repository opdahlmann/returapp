---
import hjemLys from '../assets/skjermbilder/light/giver-home.png';
import hjemMork from '../assets/skjermbilder/dark/giver-home.png';
import Telefon from './Telefon.astro';

// Demoen er designprototypen (docs/design/Returapp-standalone.html) uendret, servert som /demo/app. Den åpner i en egen fane:
// prototypen har sin egen telefonramme og fyller hele vinduet. Lenken peker på .html fordi dev-serveren bare finner filen slik;
// nginx sender den 301 til /demo/app.
interface Props { bredde?: number }
const { bredde = 360 } = Astro.props;
---

<div class="demo">
  <Telefon lys={hjemLys} mork={hjemMork} alt="Forhåndsvisning av demoen: giverens hjem-skjerm" bredde={bredde}>
    <div class="slor"></div>
    <a class="start" href="/demo/app.html" target="_blank" rel="noopener">Prøv demoen</a>
  </Telefon>
</div>

<style>
  .demo { display: flex; justify-content: center; }
  .slor { position: absolute; inset: 0; background: rgba(10, 20, 12, .18); }
  .start { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); display: inline-flex; align-items: center; height: 54px; padding: 0 28px; border-radius: var(--r-pille); background: var(--pri); color: var(--pri-tx); font-weight: 600; font-size: 17px; text-decoration: none; box-shadow: 0 12px 32px rgba(0, 0, 0, .3); transition: transform var(--t-trykk) var(--ease-out); }
  .start:active { transform: translate(-50%, -50%) scale(.97); }
  @media (hover: hover) and (pointer: fine) { .start:hover { transform: translate(-50%, -50%) scale(1.03); color: var(--pri-tx); } }
</style>
