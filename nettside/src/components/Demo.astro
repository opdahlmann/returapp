---
import hjemLys from '../assets/skjermbilder/light/giver-home.png';
import hjemMork from '../assets/skjermbilder/dark/giver-home.png';
import Telefon from './Telefon.astro';

// Demoen er designprototypen (docs/design/Returapp-standalone.html) uendret, servert som /demo/app. Den åpner i en egen fane:
// prototypen har sin egen telefonramme og fyller hele vinduet.
interface Props { bredde?: number }
const { bredde = 360 } = Astro.props;
---

<div class="demo">
  <Telefon lys={hjemLys} mork={hjemMork} alt="Forhåndsvisning av demoen: giverens hjem-skjerm" bredde={bredde}>
    <a class="start" href="/demo/app" target="_blank" rel="noopener">Prøv demoen</a>
  </Telefon>
</div>

<style>
  .demo { display: flex; justify-content: center; }
  .start { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); display: inline-flex; align-items: center; height: 54px; padding: 0 26px; border-radius: var(--r-knapp); background: var(--pri); color: var(--pri-tx); font-weight: 800; font-size: 17px; text-decoration: none; box-shadow: 0 8px 24px rgba(0, 0, 0, .25); transition: transform var(--varighet-kort) var(--kurve); }
  .start:hover { transform: translate(-50%, -50%) scale(1.03); color: var(--pri-tx); }
  .start:active { transform: translate(-50%, -50%) scale(.98); }
</style>
