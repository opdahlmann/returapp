---
import type { ImageMetadata } from 'astro';
import Telefon from './Telefon.astro';

// Kort i en vannrett bane med snap. Berøring og rullehjul er nettleserens egne (med gummistrikk på iOS). Mus drar 1:1 med
// pekerfangst; slippet projiseres til nærmeste kort og fjæren arver farten. Piler og prikker bruker samme fjær.
interface Kort { verb: string; tekst: string; lys: ImageMetadata; mork: ImageMetadata; alt: string }
interface Props { kort: Kort[]; navn: string }
const { kort, navn } = Astro.props;
// Hele banen glir inn samlet: kort utenfor skjermen ville ellers aldri fått innslipp før de ble dratt inn.
---

<div class="karusell" data-karusell data-reveal>
  <div class="spor" role="region" aria-roledescription="karusell" aria-label={navn} tabindex="0">
    {kort.map((k, i) => (
      <article class="kort kort-k">
        <div class="kort-tekst">
          <h3>{k.verb}</h3>
          <p class="dempet">{k.tekst}</p>
        </div>
        <div class="tlf"><Telefon lys={k.lys} mork={k.mork} alt={k.alt} bredde={260} /></div>
      </article>
    ))}
  </div>
  <div class="styring">
    <div class="prikker" role="tablist" aria-label="Kort">
      {kort.map((k, i) => <button type="button" role="tab" aria-label={k.verb} aria-selected={i === 0 ? 'true' : 'false'} data-i={i}></button>)}
    </div>
    <div class="piler">
      <button type="button" class="pil glass" data-retn="-1" aria-label="Forrige">
        <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M12.5 4 6.5 10l6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </button>
      <button type="button" class="pil glass" data-retn="1" aria-label="Neste">
        <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="m7.5 4 6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </button>
    </div>
  </div>
</div>

<script>
  import { Fartsmaaler, Fjaer, projiser, reduserBevegelse } from '../skript/fjaer';

  for (const rot of document.querySelectorAll<HTMLElement>('[data-karusell]')) {
    const spor = rot.querySelector<HTMLElement>('.spor')!;
    const kort = [...spor.children] as HTMLElement[];
    const prikker = [...rot.querySelectorAll<HTMLButtonElement>('[data-i]')];
    const maks = () => spor.scrollWidth - spor.clientWidth;
    const posisjoner = () => kort.map((k) => Math.min(k.offsetLeft - spor.offsetLeft, maks()));
    const naermest = (x: number) => posisjoner().reduce((b, p, i, a) => (Math.abs(p - x) < Math.abs(a[b]! - x) ? i : b), 0);
    const fjaer = new Fjaer(spor.scrollLeft, { damping: 1, response: 0.45 }, (v) => { spor.scrollLeft = v; }, () => spor.removeAttribute('data-fjaerer'));

    // Aktiv prikk følger rullingen, uansett hva som ruller.
    let ventet = 0;
    spor.addEventListener('scroll', () => {
      if (ventet) return;
      ventet = requestAnimationFrame(() => {
        ventet = 0;
        const i = naermest(spor.scrollLeft);
        prikker.forEach((p, j) => p.setAttribute('aria-selected', String(i === j)));
      });
    }, { passive: true });

    const gaaTil = (i: number, fart = 0) => {
      const x = Math.max(0, Math.min(maks(), posisjoner()[Math.max(0, Math.min(kort.length - 1, i))]!));
      if (reduserBevegelse()) { spor.scrollLeft = x; return; }
      spor.setAttribute('data-fjaerer', '');
      fjaer.value = spor.scrollLeft;
      fjaer.to(x, fart);
    };
    prikker.forEach((p) => p.addEventListener('click', () => gaaTil(Number(p.dataset.i))));
    rot.querySelectorAll<HTMLButtonElement>('[data-retn]').forEach((b) => b.addEventListener('click', () => gaaTil(naermest(spor.scrollLeft) + Number(b.dataset.retn))));
    spor.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      e.preventDefault();
      gaaTil(naermest(spor.scrollLeft) + (e.key === 'ArrowRight' ? 1 : -1));
    });

    // Mus: dra banen. Berøring får nettleserens egen rulling (touch-action), så vi bare bryr oss om mus.
    let startX = 0, startScroll = 0, drar = false;
    const fart = new Fartsmaaler();
    spor.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse' || e.button !== 0 || drar) return;
      drar = true;
      fjaer.stop();
      startX = e.clientX;
      startScroll = spor.scrollLeft;
      fart.reset(); fart.add(spor.scrollLeft);
      spor.setPointerCapture(e.pointerId);
    });
    spor.addEventListener('pointermove', (e) => {
      if (!drar) return;
      const d = startX - e.clientX;
      if (Math.abs(d) > 6) spor.setAttribute('data-drar', '');
      spor.scrollLeft = startScroll + d;
      fart.add(spor.scrollLeft);
    });
    const slipp = (e: PointerEvent) => {
      if (!drar) return;
      drar = false;
      if (spor.hasPointerCapture(e.pointerId)) spor.releasePointerCapture(e.pointerId);
      if (!spor.hasAttribute('data-drar')) return;
      const v = fart.velocity;
      // Kastet lander der farten peker, ikke nærmest der fingeren slapp. Én rask sveip er nok til neste kort.
      const her = naermest(spor.scrollLeft);
      let i = naermest(spor.scrollLeft + projiser(v));
      if (i === her && Math.abs(v) > 500) i += Math.sign(v);
      gaaTil(i, v);
      requestAnimationFrame(() => spor.removeAttribute('data-drar'));
    };
    spor.addEventListener('pointerup', slipp);
    spor.addEventListener('pointercancel', slipp);
    spor.addEventListener('click', (e) => { if (spor.hasAttribute('data-drar')) { e.preventDefault(); e.stopPropagation(); } }, true);
  }
</script>

<style>
  /* Banen går helt ut til vinduskantene, kortene starter på innholdets venstre kant. */
  .karusell { margin-inline: calc(50% - 50vw); }
  .spor {
    display: flex; gap: 20px; padding: 8px max(var(--gutter), calc(50vw - var(--maks) / 2)) 32px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none;
    cursor: grab; touch-action: pan-x pan-y; -webkit-overflow-scrolling: touch;
  }
  .spor::-webkit-scrollbar { display: none; }
  .spor[data-drar] { cursor: grabbing; scroll-snap-type: none; user-select: none; }
  .spor[data-drar] * { pointer-events: none; }
  .spor[data-fjaerer] { scroll-snap-type: none; }
  .spor:focus-visible { outline-offset: -3px; }
  .kort-k { flex: 0 0 min(86vw, 440px); scroll-snap-align: start; scroll-snap-stop: always; }
  .kort-k .kort-tekst { padding: 28px 28px 8px; }
  .kort-k h3 { font-size: 28px; letter-spacing: -.025em; }
  /* Telefonen beholder formen (align-items: flex-start, ellers strekker flex den til boksens høyde) og beskjæres nederst av kortet. */
  .tlf { display: flex; justify-content: center; align-items: flex-start; padding: 24px 28px 0; max-height: 400px; overflow: hidden; margin-top: auto; }
  .tlf :global(.telefon) { box-shadow: inset 0 0 0 1.5px rgba(255, 255, 255, .14), 0 20px 50px -20px rgba(20, 30, 20, .5); }
  .styring { display: flex; align-items: center; justify-content: space-between; padding-inline: max(var(--gutter), calc(50vw - var(--maks) / 2)); }
  .prikker { display: flex; gap: 6px; }
  .prikker button { width: 28px; height: 28px; padding: 0; border: 0; background: transparent; display: grid; place-content: center; }
  .prikker button::before { content: ''; display: block; width: 8px; height: 8px; border-radius: 50%; background: var(--mu); opacity: .4; transition: transform var(--t-ui) var(--ease-out), opacity var(--t-ui) ease; }
  .prikker button[aria-selected='true']::before { opacity: 1; background: var(--tx); transform: scale(1.25); }
  .piler { display: flex; gap: 8px; }
  .pil { width: 44px; height: 44px; border-radius: 50%; display: grid; place-content: center; color: var(--tx); transition: transform var(--t-trykk) var(--ease-out), background-color var(--t-ui) ease; }
  .pil:active { transform: scale(.94); }
  @media (hover: hover) and (pointer: fine) { .pil:hover { background: var(--sf); } }
  @media (min-width: 900px) { .kort-k { flex-basis: 480px; } }
</style>
