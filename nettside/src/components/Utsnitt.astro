---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Utsnitt av et skjermbilde (øverste del) i et kort, lys og mørk etter systemet. Til funksjonskortene.
interface Props { lys: ImageMetadata; mork: ImageMetadata; alt: string; hoyde?: number }
const { lys, mork, alt, hoyde = 240 } = Astro.props;
const bilde = (src: ImageMetadata) => getImage({ src, widths: [402, 804], format: 'webp' });
const l = await bilde(lys);
const m = await bilde(mork);
---

<picture class="utsnitt" style={`--hoyde:${hoyde}px`}>
  <source media="(prefers-color-scheme: dark)" srcset={m.srcSet.attribute} sizes="402px" type="image/webp" />
  <img src={l.src} srcset={l.srcSet.attribute} sizes="402px" width={402} height={874} alt={alt} loading="lazy" decoding="async" />
</picture>

<style>
  /* Boksen har bestemt høyde; bildet fyller den, beskåret fra toppen, og løftes litt ved hover på kortet (bare med ekte peker). */
  .utsnitt { display: block; position: relative; height: var(--hoyde); overflow: hidden; background: var(--sf2); }
  .utsnitt img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: top; transition: transform 500ms var(--ease-out); }
  @media (hover: hover) and (pointer: fine) { :global(.kort:hover) .utsnitt img { transform: scale(1.03); } }
  @media (prefers-reduced-motion: reduce) { .utsnitt img { transition: none; } }
</style>
