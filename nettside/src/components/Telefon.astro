---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Én telefonramme for alle skjermbilder (lys og mørk etter systemet). Slot for innhold oppå, som demoens knapp.
// To lag med konsentriske radier: ytre skall 44 px med 8 px luft, indre flate 36 px.
interface Props {
  lys?: ImageMetadata;
  mork?: ImageMetadata;
  alt?: string;
  eager?: boolean;
  class?: string;
  /** Bredde i px på desktop (rammen skalerer ned på mobil). */
  bredde?: number;
}
const { lys, mork, alt = '', eager = false, class: klasse = '', bredde = 320 } = Astro.props;
const WIDTHS = [402, 804, 1206];
const bilde = async (src: ImageMetadata) => getImage({ src, widths: WIDTHS, format: 'webp' });
const l = lys ? await bilde(lys) : null;
const m = mork ? await bilde(mork) : null;
const sizes = `(min-width: 768px) ${bredde}px, 80vw`;
---

<div class:list={['telefon', klasse]} style={`--bredde:${bredde}px`}>
  <div class="skjerm">
    {l && (
      <picture>
        {m && <source media="(prefers-color-scheme: dark)" srcset={m.srcSet.attribute} sizes={sizes} type="image/webp" />}
        <source srcset={l.srcSet.attribute} sizes={sizes} type="image/webp" />
        <img src={l.src} width={402} height={874} alt={alt} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding="async" />
      </picture>
    )}
    <slot />
  </div>
</div>

<style>
  .telefon { width: min(var(--bredde), 100%); aspect-ratio: 402 / 874; padding: 8px; border-radius: 44px; background: var(--sf2); border: 1px solid var(--bd); box-shadow: 0 20px 60px rgba(20, 30, 20, .18); }
  :global(.mork) .telefon { background: rgba(255, 255, 255, .08); border-color: rgba(255, 255, 255, .14); box-shadow: 0 20px 60px rgba(0, 0, 0, .35); }
  .skjerm { position: relative; width: 100%; height: 100%; border-radius: 36px; overflow: hidden; background: var(--bg); }
  .skjerm img { width: 100%; height: 100%; object-fit: cover; }
</style>
