---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Én telefonramme for alle skjermbilder (lys og mørk etter systemet). Mørk ramme og dyp skygge, ingen «øy»: skjermbildene har
// ingen statuslinje, så en øy ville dekket appens overskrift. Slot for innhold oppå.
interface Props {
  lys?: ImageMetadata;
  mork?: ImageMetadata;
  alt?: string;
  eager?: boolean;
  class?: string;
  /** Bredde i px på desktop (rammen skalerer ned på mobil). */
  bredde?: number;
}
const { lys, mork, alt = '', eager = false, class: klasse = '', bredde = 320 } = Astro.props;
const WIDTHS = [402, 804, 1206];
const bilde = async (src: ImageMetadata) => getImage({ src, widths: WIDTHS, format: 'webp' });
const l = lys ? await bilde(lys) : null;
const m = mork ? await bilde(mork) : null;
const sizes = `(min-width: 768px) ${bredde}px, 80vw`;
---

<div class:list={['telefon', klasse]} style={`--bredde:${bredde}px`}>
  <div class="skjerm">
    {l && (
      <picture>
        {m && <source media="(prefers-color-scheme: dark)" srcset={m.srcSet.attribute} sizes={sizes} type="image/webp" />}
        <source srcset={l.srcSet.attribute} sizes={sizes} type="image/webp" />
        <img src={l.src} width={402} height={874} alt={alt} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding="async" />
      </picture>
    )}
    <slot />
  </div>
</div>

<style>
  .telefon {
    width: min(var(--bredde), 100%); aspect-ratio: 422 / 894; padding: 10px; border-radius: 58px; background: #0d110e;
    box-shadow: inset 0 0 0 1.5px rgba(255, 255, 255, .14), 0 40px 90px -30px rgba(20, 30, 20, .55), 0 2px 6px rgba(0, 0, 0, .25);
    transform-style: preserve-3d;
  }
  .skjerm { position: relative; width: 100%; height: 100%; border-radius: 48px; overflow: hidden; background: var(--bg); }
  .skjerm img { width: 100%; height: 100%; object-fit: cover; }
</style>
