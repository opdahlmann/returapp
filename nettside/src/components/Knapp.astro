---
// Pilleknapp, 50 px. Trykk gir skala .97 på 160 ms (tilbakemelding på pointer-down, ikke på slipp). Hover bare med ekte peker.
interface Props { href: string; variant?: 'primar' | 'sekundar'; liten?: boolean; class?: string; target?: string }
const { href, variant = 'primar', liten = false, class: klasse = '', target } = Astro.props;
const ekstern = /^https?:/.test(href);
---

<a href={href} class:list={['knapp', variant, { liten }, klasse]} rel={ekstern || target ? 'noopener' : undefined} target={target}><slot /></a>

<style>
  .knapp {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px; height: 50px; padding: 0 24px; border-radius: var(--r-pille);
    font-weight: 600; font-size: 16px; letter-spacing: -.01em; text-decoration: none; white-space: nowrap; border: 1px solid transparent;
    transition: transform var(--t-trykk) var(--ease-out), background-color var(--t-ui) ease, border-color var(--t-ui) ease, box-shadow var(--t-ui) ease;
  }
  .knapp:active { transform: scale(.97); }
  .liten { height: 40px; padding: 0 16px; font-size: 15px; }
  .primar { background: var(--pri); color: var(--pri-tx); box-shadow: inset 0 1px 0 rgba(255, 255, 255, .18); }
  .sekundar { background: var(--glass); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); color: var(--tx); border-color: var(--bd); }
  @media (hover: hover) and (pointer: fine) {
    .primar:hover { background: var(--tint-tx); color: var(--pri-tx); }
    .sekundar:hover { border-color: var(--mu); color: var(--tx); }
    :global(.mork) .primar:hover { background: #c4ecd0; color: #0b1a0f; }
    :global(.mork) .sekundar:hover { border-color: var(--mork-tekst); color: var(--mork-tekst); }
  }
  :global(.mork) .primar { background: var(--mork-aksent); color: #0b1a0f; }
  :global(.mork) .sekundar { background: rgba(255, 255, 255, .08); color: var(--mork-tekst); border-color: rgba(255, 255, 255, .25); }
  @media (prefers-reduced-transparency: reduce) { .sekundar { backdrop-filter: none; -webkit-backdrop-filter: none; background: var(--sf); } }
</style>
