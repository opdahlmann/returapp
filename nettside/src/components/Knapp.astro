---
// Én linje, 50 px høy som appens primærknapp. «primar» er grønn (lime på mørkt bånd), «sekundar» har kant.
interface Props { href: string; variant?: 'primar' | 'sekundar'; liten?: boolean; class?: string }
const { href, variant = 'primar', liten = false, class: klasse = '' } = Astro.props;
const ekstern = /^https?:/.test(href);
---

<a href={href} class:list={['knapp', variant, { liten }, klasse]} rel={ekstern ? 'noopener' : undefined}><slot /></a>

<style>
  .knapp { display: inline-flex; align-items: center; justify-content: center; gap: 8px; height: 50px; padding: 0 22px; border-radius: var(--r-knapp); font-weight: 700; font-size: 16px; text-decoration: none; white-space: nowrap; border: 1.5px solid transparent; transition: transform var(--varighet-kort) var(--kurve), background-color var(--varighet-kort) var(--kurve), border-color var(--varighet-kort) var(--kurve); }
  .knapp:active { transform: scale(.98); }
  .liten { height: 40px; padding: 0 16px; font-size: 15px; }
  .primar { background: var(--pri); color: var(--pri-tx); }
  .primar:hover { background: var(--tint-tx); color: var(--pri-tx); }
  .sekundar { background: var(--sf); color: var(--tx); border-color: var(--bd); }
  .sekundar:hover { border-color: var(--mu); color: var(--tx); }
  :global(.mork) .primar { background: var(--mork-aksent); color: #182119; }
  :global(.mork) .primar:hover { background: #cdeeb6; color: #182119; }
  :global(.mork) .sekundar { background: transparent; color: var(--mork-tekst); border-color: rgba(255, 255, 255, .35); }
  :global(.mork) .sekundar:hover { border-color: var(--mork-tekst); color: var(--mork-tekst); }
</style>
