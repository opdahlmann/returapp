---
// Native <details>, men åpning og lukking animeres (høyde + opasitet, 240 ms ease-out) via Web Animations API. Kan avbrytes midt i:
// ny animasjon starter fra den høyden som vises nå. Samme data brukes til FAQPage-skjemaet (Seo.astro).
interface Props { sporsmal: { q: string; a: string }[] }
const { sporsmal } = Astro.props;
---

<div class="faq" data-faq>
  {sporsmal.map(({ q, a }) => (
    <details>
      <summary><span>{q}</span><svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true"><path d="M11 4v14M4 11h14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg></summary>
      <div class="innhold"><p class="prosa dempet">{a}</p></div>
    </details>
  ))}
</div>

<script>
  const reduser = matchMedia('(prefers-reduced-motion: reduce)');
  for (const d of document.querySelectorAll<HTMLDetailsElement>('[data-faq] details')) {
    const innhold = d.querySelector<HTMLElement>('.innhold')!;
    let anim: Animation | null = null;
    d.querySelector('summary')!.addEventListener('click', (e) => {
      e.preventDefault();
      if (reduser.matches) { d.open = !d.open; return; }
      const fra = anim ? innhold.getBoundingClientRect().height : d.open ? innhold.scrollHeight : 0;
      anim?.cancel();
      // Avbrutt midt i: snu retningen. Ellers: åpne hvis lukket.
      const skalAapne = anim ? d.hasAttribute('data-lukker') : !d.open;
      d.open = true;
      d.toggleAttribute('data-lukker', !skalAapne);
      const til = skalAapne ? innhold.scrollHeight : 0;
      anim = innhold.animate([{ height: `${fra}px`, opacity: skalAapne ? fra / Math.max(til, 1) : 1 }, { height: `${til}px`, opacity: skalAapne ? 1 : 0 }], { duration: 240, easing: 'cubic-bezier(.23, 1, .32, 1)' });
      anim.onfinish = () => { anim = null; if (!skalAapne) { d.open = false; d.removeAttribute('data-lukker'); } };
    });
  }
</script>

<style>
  .faq { max-width: 760px; margin-inline: auto; }
  details { border-top: 1px solid var(--bd); }
  details:last-child { border-bottom: 1px solid var(--bd); }
  summary { list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 20px 4px; font-weight: 600; font-size: 19px; letter-spacing: -.015em; cursor: pointer; border-radius: 10px; transition: opacity var(--t-trykk) ease; }
  summary:active { opacity: .7; }
  summary::-webkit-details-marker { display: none; }
  summary svg { flex: none; color: var(--pri); transition: transform var(--t-ui) var(--ease-out); }
  details[open]:not([data-lukker]) summary svg { transform: rotate(45deg); }
  .innhold { overflow: hidden; }
  .innhold p { padding: 0 4px 22px; }
</style>
