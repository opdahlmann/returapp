---
// Native <details>: nettleserens egen åpning, ingen høydeanimasjon. Samme data brukes til FAQPage-skjemaet (N7).
interface Props { sporsmal: { q: string; a: string }[] }
const { sporsmal } = Astro.props;
---

<div class="faq">
  {sporsmal.map(({ q, a }) => (
    <details>
      <summary>{q}</summary>
      <p class="prosa">{a}</p>
    </details>
  ))}
</div>

<style>
  .faq { max-width: 760px; }
  details { border-top: 1px solid var(--bd); }
  details:last-child { border-bottom: 1px solid var(--bd); }
  summary { list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 18px 4px; font-weight: 700; font-size: 18px; cursor: pointer; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; font-size: 24px; font-weight: 400; color: var(--pri); flex: none; width: 28px; text-align: center; transition: transform var(--varighet-kort) var(--kurve); }
  details[open] summary::after { transform: rotate(45deg); }
  details p { padding: 0 4px 20px; color: var(--mu); }
</style>
