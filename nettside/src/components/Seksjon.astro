---
// Én seksjon: bredde, avstand og valgfritt mørkt bånd i innloggingspaletten.
interface Props { id?: string; mork?: boolean; class?: string; stram?: boolean }
const { id, mork = false, class: klasse = '', stram = false } = Astro.props;
---

<section id={id} class:list={['sek', { mork, stram }, klasse]}>
  <div class="wrap"><slot /></div>
</section>

<style>
  .sek { padding-block: var(--sek); }
  .stram { padding-block: calc(var(--sek) * .6); }
  .sek + .sek:not(.mork) { padding-top: 0; }
  .mork { background: var(--mork); color: var(--mork-tekst); }
  .mork :global(.dempet) { color: var(--mork-dempet); }
</style>
