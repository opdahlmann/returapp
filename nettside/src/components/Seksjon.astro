---
// Én seksjon: bredde og avstand. «hode» gir sentrert overskrift med ingress over innholdet.
interface Props { id?: string; class?: string; stram?: boolean; h2?: string; ingress?: string; eyebrow?: string }
const { id, class: klasse = '', stram = false, h2, ingress, eyebrow } = Astro.props;
---

<section id={id} class:list={['sek', { stram }, klasse]}>
  <div class="wrap">
    {h2 && (
      <div class="hode midt" data-reveal>
        {eyebrow && <span class="eyebrow">{eyebrow}</span>}
        <h2>{h2}</h2>
        {ingress && <p class="ingress dempet">{ingress}</p>}
      </div>
    )}
    <slot />
  </div>
</section>

<style>
  .sek { padding-block: var(--sek); }
  .stram { padding-block: calc(var(--sek) * .5); }
  .sek + .sek { padding-top: 0; }
  .hode { max-width: 760px; margin: 0 auto 48px; }
  .hode .ingress { margin-top: 16px; }
  .eyebrow { display: inline-block; font-size: 15px; font-weight: 600; letter-spacing: .01em; color: var(--pri); margin-bottom: 14px; }
  @media (min-width: 768px) { .hode { margin-bottom: 64px; } }
</style>
