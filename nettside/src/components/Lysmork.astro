---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Sammenligning lys/mørk: to skjermbilder oppå hverandre, det mørke klippes med clip-path. Glideren er en ekte <input type=range>
// som dekker hele telefonen (gjennomsiktig), så det virker med finger, mus og tastatur uten egen dra-kode. Direkte manipulasjon: ingen overgang.
interface Props { lys: ImageMetadata; mork: ImageMetadata; alt: string; bredde?: number }
const { lys, mork, alt, bredde = 360 } = Astro.props;
const bilde = (src: ImageMetadata) => getImage({ src, widths: [402, 804], format: 'webp' });
const l = await bilde(lys);
const m = await bilde(mork);
---

<div class="lysmork" data-lysmork style={`--bredde:${bredde}px`}>
  <div class="telefon">
    <div class="skjerm">
      <img src={l.src} srcset={l.srcSet.attribute} sizes={`${bredde}px`} width={402} height={874} alt={alt} loading="lazy" decoding="async" />
      <img class="moerk" src={m.src} srcset={m.srcSet.attribute} sizes={`${bredde}px`} width={402} height={874} alt="" loading="lazy" decoding="async" />
      <div class="hank" aria-hidden="true"><span></span></div>
      <input type="range" min="0" max="100" value="50" aria-label="Hvor stor del av skjermen som vises i mørk modus" />
    </div>
  </div>
</div>

<script>
  for (const rot of document.querySelectorAll<HTMLElement>('[data-lysmork]')) {
    const inn = rot.querySelector<HTMLInputElement>('input')!;
    const moerk = rot.querySelector<HTMLElement>('.moerk')!;
    const hank = rot.querySelector<HTMLElement>('.hank')!;
    const tegn = () => {
      const p = Number(inn.value);
      moerk.style.clipPath = `inset(0 0 0 ${p}%)`;
      hank.style.left = `${p}%`;
    };
    inn.addEventListener('input', tegn);
    tegn();
  }
</script>

<style>
  .lysmork { display: flex; justify-content: center; }
  .telefon { width: min(var(--bredde), 100%); aspect-ratio: 422 / 894; padding: 10px; border-radius: 58px; background: #0d110e; box-shadow: inset 0 0 0 1.5px rgba(255, 255, 255, .14), 0 40px 90px -30px rgba(20, 30, 20, .55); }
  .skjerm { position: relative; width: 100%; height: 100%; border-radius: 48px; overflow: hidden; background: var(--bg); }
  .skjerm::before { content: ''; position: absolute; top: 3.2%; left: 50%; width: 24%; aspect-ratio: 96 / 28; border-radius: 999px; background: #0d110e; transform: translateX(-50%); z-index: 1; }
  /* Statusfeltet (11 %) er bildets egen padding med appens bakgrunnsfarge, så hver halvdel får riktig farge helt opp. */
  .skjerm img { position: absolute; inset: 0; width: 100%; height: 100%; padding-top: 11%; background: #F3F4EF; object-fit: cover; object-position: top; }
  .skjerm .moerk { background: #0F1512; clip-path: inset(0 0 0 50%); }
  .hank { position: absolute; top: 0; bottom: 0; left: 50%; width: 2px; margin-left: -1px; background: rgba(255, 255, 255, .9); box-shadow: 0 0 0 1px rgba(0, 0, 0, .15); pointer-events: none; }
  .hank span { position: absolute; top: 50%; left: 50%; width: 44px; height: 44px; border-radius: 50%; background: rgba(255, 255, 255, .85); backdrop-filter: blur(8px); box-shadow: 0 6px 20px rgba(0, 0, 0, .25); transform: translate(-50%, -50%); }
  .hank span::before, .hank span::after { content: ''; position: absolute; top: 50%; width: 7px; height: 7px; border: solid #182119; border-width: 0 0 2px 2px; transform: translateY(-50%) rotate(45deg); left: 12px; }
  .hank span::after { left: auto; right: 12px; transform: translateY(-50%) rotate(-135deg); }
  input { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: ew-resize; touch-action: pan-y; }
  input:focus-visible + * , .skjerm:has(input:focus-visible) { outline: 3px solid var(--pri); outline-offset: 4px; }
</style>
