---
import '../../../frontend/src/tokens.css';
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import Seo, { type SeoProps } from '../components/Seo.astro';

type Props = SeoProps;
const props = Astro.props;
---

<!doctype html>
<html lang="nb" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <!-- Tema før stilene, så det ikke blinker: appens tokens leser data-theme på <html>. -->
    <script is:inline>
      (function () {
        var m = matchMedia('(prefers-color-scheme: dark)');
        var s = function () { document.documentElement.dataset.theme = m.matches ? 'dark' : 'light'; };
        s();
        m.addEventListener('change', s);
      })();
    </script>
    <Seo {...props} />
  </head>
  <body>
    <a class="hopp" href="#innhold">Hopp til innholdet</a>
    <div id="topp-vakt" aria-hidden="true"></div>
    <Nav />
    <main id="innhold"><slot /></main>
    <Footer />
    <script>
      // Én observer for innslipp: [data-reveal] får er-synlig én gang når 15 % er i syne. Uten bevegelse gjør CSS bare en fade.
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            e.target.classList.add('er-synlig');
            io.unobserve(e.target);
          }
        },
        { threshold: 0.15 },
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
      // Rullekant: når vakten øverst er ute av syne, får navigasjonen tyngre skygge (i stedet for en fast 1 px-strek).
      const vakt = document.getElementById('topp-vakt');
      const topp = document.querySelector('header.topp');
      if (vakt && topp) new IntersectionObserver(([e]) => topp.toggleAttribute('data-rullet', !e!.isIntersecting)).observe(vakt);
    </script>
  </body>
</html>

<style>
  #topp-vakt { position: absolute; top: 0; height: 1px; width: 1px; }
</style>
