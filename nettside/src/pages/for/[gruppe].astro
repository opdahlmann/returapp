---
import type { ImageMetadata } from 'astro';
import Faq from '../../components/Faq.astro';
import Hero from '../../components/Hero.astro';
import Knapp from '../../components/Knapp.astro';
import Reveal from '../../components/Reveal.astro';
import Seksjon from '../../components/Seksjon.astro';
import { grupper } from '../../innhold/for';
import Base from '../../layouts/Base.astro';

export function getStaticPaths() {
  return Object.keys(grupper).map((gruppe) => ({ params: { gruppe } }));
}
const g = grupper[Astro.params.gruppe!]!;
const alle = import.meta.glob<{ default: ImageMetadata }>('../../assets/skjermbilder/*/*.png', { eager: true });
const bilde = (tema: 'light' | 'dark') => alle[`../../assets/skjermbilder/${tema}/${g.bilde}.png`]!.default;
---

<Base tittel={g.tittel} beskrivelse={g.beskrivelse} sti={g.sti} faq={g.faq} brodsmuler={[[g.tittel, g.sti]]}>
  <Hero h1={g.h1} ingress={g.ingress} primar={g.cta} lys={bilde('light')} mork={bilde('dark')} alt={g.alt} />

  <Seksjon h2="Slik virker det">
    <div class="steg">
      {g.slik.map((s, i) => (
        <Reveal i={i} class="kort steg-kort">
          <div class="kort-tekst">
            <span class="nr tall" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3>{s.verb}</h3>
            <p class="dempet">{s.tekst}</p>
          </div>
        </Reveal>
      ))}
    </div>
  </Seksjon>

  <Seksjon>
    <Reveal class="flis tonet faar">
      <h2>{g.faarH2}</h2>
      <ul class="hak">{g.faar.map((p) => <li><svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true"><path d="m5 11.5 4 4 8-9" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg><span>{p}</span></li>)}</ul>
    </Reveal>
  </Seksjon>

  {g.ekstra && (
    <Seksjon>
      <Reveal class="prosa ekstra">
        <h2>{g.ekstra.h2}</h2>
        {g.ekstra.avsnitt.map((a) => <p class="dempet">{a}</p>)}
      </Reveal>
    </Seksjon>
  )}

  <Seksjon h2="Spørsmål og svar">
    <Reveal><Faq sporsmal={g.faq} /></Reveal>
  </Seksjon>

  <Seksjon stram>
    <Reveal class="flis mork cta midt">
      <h2>{g.h1}</h2>
      <div class="knapper"><Knapp href={g.cta.href}>{g.cta.tekst}</Knapp></div>
    </Reveal>
  </Seksjon>
</Base>

<style>
  .steg { display: grid; gap: 20px; }
  .steg :global(.steg-kort .kort-tekst) { padding: 28px; }
  .nr { display: block; font-size: 15px; font-weight: 600; color: var(--pri); margin-bottom: 14px; }
  .steg h3 { font-size: 28px; letter-spacing: -.025em; }
  .steg p { margin-top: 10px; font-size: 17px; }
  @media (min-width: 768px) { .steg { grid-template-columns: repeat(3, 1fr); } }
  .faar { margin-inline: auto; max-width: 880px; }
  .faar h2 { font-size: clamp(28px, 1.4vw + 20px, 40px); margin-bottom: 28px; }
  .hak { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; font-size: 18px; }
  .hak li { display: flex; gap: 14px; align-items: flex-start; }
  .hak svg { flex: none; margin-top: 2px; }
  .ekstra { margin-inline: auto; }
  .ekstra h2 { margin-bottom: 24px; }
  .ekstra p + p { margin-top: 14px; }
  .cta { display: flex; flex-direction: column; align-items: center; padding-block: clamp(48px, 8vw, 96px); }
  .knapper { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 28px; }
</style>
