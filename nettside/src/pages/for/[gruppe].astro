---
import type { ImageMetadata } from 'astro';
import Faq from '../../components/Faq.astro';
import Knapp from '../../components/Knapp.astro';
import Seksjon from '../../components/Seksjon.astro';
import Telefon from '../../components/Telefon.astro';
import { grupper } from '../../innhold/for';
import Base from '../../layouts/Base.astro';

export function getStaticPaths() {
  return Object.keys(grupper).map((gruppe) => ({ params: { gruppe } }));
}
const g = grupper[Astro.params.gruppe!]!;
const alle = import.meta.glob<{ default: ImageMetadata }>('../../assets/skjermbilder/*/*.png', { eager: true });
const bilde = (tema: 'light' | 'dark') => alle[`../../assets/skjermbilder/${tema}/${g.bilde}.png`]!.default;
---

<Base tittel={g.tittel} beskrivelse={g.beskrivelse} sti={g.sti} faq={g.faq} brodsmuler={[[g.tittel, g.sti]]}>
  <Seksjon mork class="hero-sek">
    <div class="hero">
      <div>
        <h1>{g.h1}</h1>
        <p class="ingress dempet">{g.ingress}</p>
        <div class="knapper"><Knapp href={g.cta.href}>{g.cta.tekst}</Knapp><Knapp href="/demo" variant="sekundar">Prøv demoen</Knapp></div>
      </div>
      <div class="hero-telefon"><Telefon lys={bilde('light')} mork={bilde('dark')} alt={g.alt} eager /></div>
    </div>
  </Seksjon>

  <Seksjon>
    <h2>Slik virker det</h2>
    <div class="steg">
      {g.slik.map((s) => (
        <div>
          <h3>{s.verb}</h3>
          <p class="dempet">{s.tekst}</p>
        </div>
      ))}
    </div>
  </Seksjon>

  <Seksjon>
    <div class="prosa">
      <h2>{g.faarH2}</h2>
      <ul class="liste">{g.faar.map((p) => <li>{p}</li>)}</ul>
    </div>
  </Seksjon>

  {g.ekstra && (
    <Seksjon>
      <div class="prosa">
        <h2>{g.ekstra.h2}</h2>
        {g.ekstra.avsnitt.map((a) => <p class="dempet">{a}</p>)}
      </div>
    </Seksjon>
  )}

  <Seksjon>
    <h2>Spørsmål og svar</h2>
    <Faq sporsmal={g.faq} />
  </Seksjon>

  <Seksjon mork stram>
    <div class="cta">
      <h2>{g.h1}</h2>
      <div class="knapper"><Knapp href={g.cta.href}>{g.cta.tekst}</Knapp></div>
    </div>
  </Seksjon>
</Base>

<style>
  h2 { margin-bottom: 24px; }
  .knapper { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .hero-sek { padding-block: 56px 0; }
  .hero { display: grid; gap: 40px; align-items: center; }
  .hero .ingress { margin-top: 20px; }
  .hero-telefon { max-height: 300px; overflow: hidden; justify-self: center; }
  @media (min-width: 900px) {
    .hero-sek { padding-block: 80px 0; }
    .hero { grid-template-columns: 7fr 5fr; gap: 64px; }
    .hero-telefon { max-height: 560px; justify-self: end; padding-top: 8px; }
  }
  .steg { display: grid; gap: 28px; }
  .steg h3 { font-size: 24px; }
  .steg p { margin-top: 8px; }
  @media (min-width: 768px) { .steg { grid-template-columns: repeat(3, 1fr); gap: 40px; } }
  .liste { margin: 0; padding-left: 1.2em; display: grid; gap: 12px; font-size: 18px; }
  .prosa p + p { margin-top: 12px; }
  .cta { text-align: center; display: flex; flex-direction: column; align-items: center; }
  .cta .knapper { justify-content: center; margin-top: 8px; }
</style>
