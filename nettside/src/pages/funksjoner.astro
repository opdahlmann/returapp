---
import type { ImageMetadata } from 'astro';
import Hero from '../components/Hero.astro';
import Knapp from '../components/Knapp.astro';
import Reveal from '../components/Reveal.astro';
import Seksjon from '../components/Seksjon.astro';
import Utsnitt from '../components/Utsnitt.astro';
import { APPLY_URL, APP_URL } from '../consts';
import { beskrivelse, h1, ingress, kategorier, roller, statuser, tittel } from '../innhold/funksjoner';
import Base from '../layouts/Base.astro';

const alle = import.meta.glob<{ default: ImageMetadata }>('../assets/skjermbilder/*/*.png', { eager: true });
const bilde = (tema: 'light' | 'dark', navn: string) => alle[`../assets/skjermbilder/${tema}/${navn}.png`]!.default;
---

<Base tittel={tittel} beskrivelse={beskrivelse} sti="/funksjoner" app brodsmuler={[['Funksjoner', '/funksjoner']]}>
  <Hero h1={h1} ingress={ingress} primar={{ tekst: 'Meld henting', href: APP_URL }} lys={bilde('light', 'giver-detail')} mork={bilde('dark', 'giver-detail')} alt="Én henting sett fra giveren: bilder, tidslinje og sjåfør" />

  <Seksjon luft>
    <h2>Hver rolle ser sitt</h2>
    <div class="roller">
      {roller.map((r, i) => (
        <Reveal i={i} class:list={['celle', { rad: !!r.bilde, tonet: !r.bilde }]}>
          {r.bilde && <Utsnitt lys={bilde('light', r.bilde)} mork={bilde('dark', r.bilde)} alt={r.alt ?? ''} hoyde={240} />}
          <div class="celle-tekst">
            <h3>{r.navn}</h3>
            <ul class="liste">{r.punkter.map((p) => <li>{p}</li>)}</ul>
          </div>
        </Reveal>
      ))}
    </div>
  </Seksjon>

  <Seksjon>
    <h2>Hva kan meldes</h2>
    <p class="dempet prosa">Tolv kategorier. Superbrukeren kan legge til flere.</p>
    <ul class="chips">{kategorier.map((k) => <li>{k}</li>)}</ul>
  </Seksjon>

  <Seksjon>
    <h2>Statusene en henting går gjennom</h2>
    <ol class="statuser">
      {statuser.map((s) => (
        <li>
          <span class:list={['pille', s.farge]}>{s.navn}</span>
          <span class="dempet">{s.tekst}</span>
        </li>
      ))}
    </ol>
  </Seksjon>

  <Seksjon mork stram>
    <div class="cta">
      <h2>Har dere noe som skal ut?</h2>
      <div class="knapper"><Knapp href={APP_URL}>Meld henting</Knapp><Knapp href={APPLY_URL} variant="sekundar">Bli hentefirma</Knapp></div>
    </div>
  </Seksjon>
</Base>

<style>
  h2 { margin-bottom: 24px; }
  /* Fire roller i samme celler som forsidens bento (global.css): to med telefonutsnitt til høyre, to tonet. */
  .roller { display: grid; gap: 16px; }
  .roller :global(.celle-tekst h3) { margin-bottom: 4px; }
  /* Desktop: de to med telefon tar hele bredden (bred tekstspalte, kort celle), de to tonede deler en rad. */
  @media (min-width: 768px) {
    .roller { grid-template-columns: 1fr 1fr; }
    .roller :global(.rad) { grid-column: span 2; }
  }

  .chips { list-style: none; margin: 20px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .chips li { height: 38px; padding: 0 16px; display: inline-flex; align-items: center; border-radius: 999px; border: 1.5px solid var(--bd); background: var(--sf); font-weight: 600; }

  /* Statuspiller som i appen: radius 999, 12 px / 700, appens statusfarger. */
  .statuser { list-style: none; margin: 0; padding: 0; display: grid; }
  .statuser li { display: grid; gap: 8px; padding: 16px 0; border-top: 1px solid var(--bd); align-items: center; }
  .statuser li:last-child { border-bottom: 1px solid var(--bd); }
  .pille { justify-self: start; border-radius: 999px; padding: 5px 12px; font-size: 12px; font-weight: 700; white-space: nowrap; }
  .info { color: var(--info); background: var(--info-bg); }
  .warn { color: var(--warn); background: var(--warn-bg); }
  .tint { color: var(--tint-tx); background: var(--tint); }
  .pri { color: var(--pri-tx); background: var(--pri); }
  .dan { color: var(--dan); background: var(--dan-bg); }
  .mu { color: var(--tx); background: var(--sf2); } /* appen bruker --mu her, men det gir bare 4,3:1 på --sf2 */
  @media (min-width: 768px) { .statuser li { grid-template-columns: 160px 1fr; gap: 24px; } }

  .cta { text-align: center; display: flex; flex-direction: column; align-items: center; }
  .knapper { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 8px; }
</style>
