---
import type { ImageMetadata } from 'astro';
import Faner from '../components/Faner.astro';
import Hero from '../components/Hero.astro';
import Knapp from '../components/Knapp.astro';
import Seksjon from '../components/Seksjon.astro';
import { APPLY_URL, APP_URL } from '../consts';
import { beskrivelse, h1, ingress, kategorier, roller, statuser, tittel } from '../innhold/funksjoner';
import Base from '../layouts/Base.astro';

const alle = import.meta.glob<{ default: ImageMetadata }>('../assets/skjermbilder/*/*.png', { eager: true });
const bilde = (tema: 'light' | 'dark', navn: string) => alle[`../assets/skjermbilder/${tema}/${navn}.png`]!.default;
---

<Base tittel={tittel} beskrivelse={beskrivelse} sti="/funksjoner" app brodsmuler={[['Funksjoner', '/funksjoner']]}>
  <Hero h1={h1} ingress={ingress} primar={{ tekst: 'Meld henting', href: APP_URL }} lys={bilde('light', 'giver-detail')} mork={bilde('dark', 'giver-detail')} alt="Én henting sett fra giveren: bilder, tidslinje og sjåfør" />

  <Seksjon h2="Hver rolle ser sitt" ingress="Velg en rolle. Fanen glir, skjermen følger.">
    <div data-reveal>
      <Faner navn="Roller" faner={roller.map((r) => ({ navn: r.navn, punkter: r.punkter, lys: r.bilde ? bilde('light', r.bilde) : undefined, mork: r.bilde ? bilde('dark', r.bilde) : undefined, alt: r.alt }))} />
    </div>
  </Seksjon>

  <Seksjon h2="Hva kan meldes" ingress="Tolv kategorier. Superbrukeren kan legge til flere.">
    <ul class="chips">{kategorier.map((k, i) => <li data-reveal style={`--i:${i}`}>{k}</li>)}</ul>
  </Seksjon>

  <Seksjon h2="Statusene en henting går gjennom" ingress="Linjen tegnes mens du ruller.">
    <ol class="tidslinje">
      <li class="strek" aria-hidden="true"></li>
      {statuser.map((s, i) => (
        <li data-reveal style={`--i:${i % 3}`}>
          <span class:list={['pille', s.farge]}>{s.navn}</span>
          <span class="dempet">{s.tekst}</span>
        </li>
      ))}
    </ol>
  </Seksjon>

  <Seksjon stram>
    <div data-reveal class="flis mork cta midt">
      <h2>Har dere noe som skal ut?</h2>
      <div class="knapper"><Knapp href={APP_URL}>Meld henting</Knapp><Knapp href={APPLY_URL} variant="sekundar">Bli hentefirma</Knapp></div>
    </div>
  </Seksjon>
</Base>

<style>
  .chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; max-width: 760px; margin-inline: auto; }
  .chips li { height: 44px; padding: 0 20px; display: inline-flex; align-items: center; border-radius: var(--r-pille); background: var(--sf); box-shadow: var(--sh-lav); font-weight: 600; font-size: 16px; letter-spacing: -.01em; }

  /* Tidslinje: statuspiller på en vertikal linje som tegnes av rullingen (native scroll-driven animation der det finnes). */
  .tidslinje { position: relative; list-style: none; margin: 0 auto; padding: 0 0 0 36px; max-width: 760px; display: grid; gap: 28px; }
  .tidslinje::before, .strek { content: ''; position: absolute; left: 10px; top: 12px; bottom: 12px; width: 2px; border-radius: 2px; background: var(--bd); }
  .strek { background: var(--pri); transform-origin: top; transform: scaleY(0); }
  .tidslinje > li:not(.strek) { position: relative; display: grid; gap: 8px; align-items: center; }
  .tidslinje > li:not(.strek)::before { content: ''; position: absolute; left: -31px; top: 8px; width: 12px; height: 12px; border-radius: 50%; background: var(--bg); border: 2px solid var(--pri); }
  .pille { justify-self: start; border-radius: var(--r-pille); padding: 6px 14px; font-size: 13px; font-weight: 700; letter-spacing: .01em; white-space: nowrap; }
  .info { color: var(--info); background: var(--info-bg); }
  .warn { color: var(--warn); background: var(--warn-bg); }
  .tint { color: var(--tint-tx); background: var(--tint); }
  .pri { color: var(--pri-tx); background: var(--pri); }
  .dan { color: var(--dan); background: var(--dan-bg); }
  .mu { color: var(--tx); background: var(--sf2); }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .strek { animation: tegn linear both; animation-timeline: view(); animation-range: entry 30% exit 60%; }
    }
  }
  @media (prefers-reduced-motion: reduce) { .strek { transform: none; } }
  @keyframes tegn { from { transform: scaleY(0); } to { transform: scaleY(1); } }
  @media (min-width: 768px) { .tidslinje > li:not(.strek) { grid-template-columns: 170px 1fr; gap: 24px; } }

  .cta { display: flex; flex-direction: column; align-items: center; padding-block: clamp(48px, 8vw, 96px); }
  .knapper { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 28px; }
</style>
