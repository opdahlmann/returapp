---
import Demo from '../components/Demo.astro';
import Seksjon from '../components/Seksjon.astro';
import Base from '../layouts/Base.astro';

const roller = [
  ['Byggeplass', 'Meld en henting: velg kategori, legg til bilder, si hvor mye og hvor det står.'],
  ['Sjåfør', 'Se dagens stopp, ta et oppdrag fra børsen, og bekreft en henting med bilde og mengde.'],
  ['Retur-admin', 'Tildel en ny henteordre til en sjåfør, legg en på børsen, og planlegg ruten.'],
  ['Superbruker', 'Godkjenn hentefirmaet som venter, og se ordre uten dekning.'],
];
---

<Base tittel="Prøv Returapp i nettleseren" beskrivelse="Klikk deg gjennom appen med fiktive data: meld en henting, ta oppdrag som sjåfør, tildel som hentefirma, godkjenn som superbruker. Ingenting lagres." sti="/demo" brodsmuler={[['Demo', '/demo']]}>
  <section class="topp-sek">
    <div class="wrap midt topp">
      <h1>Prøv den før dere bestemmer dere</h1>
      <p class="ingress dempet">Fiktive firma og hentinger. Hvilken som helst kode logger inn, og rollen velges på «Hvem er du i dag?». Demoen åpner i en egen fane, og ingenting lagres.</p>
    </div>
  </section>
  <Seksjon>
    <div class="oppsett">
      <div data-reveal><Demo bredde={380} /></div>
      <div class="roller">
        <h2>Verdt å prøve</h2>
        {roller.map(([rolle, tekst], i) => (
          <div data-reveal style={`--i:${i}`} class="kort rolle">
            <div class="kort-tekst">
              <h3>{rolle}</h3>
              <p class="dempet">{tekst}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </Seksjon>
</Base>

<style>
  .topp-sek { padding-top: calc(76px + 6vh); }
  .topp { max-width: 800px; padding-bottom: 56px; }
  .topp h1 { font-size: clamp(38px, 2.4vw + 24px, 68px); }
  .ingress { margin-top: 20px; }
  .oppsett { display: grid; gap: 48px; align-items: start; }
  .roller { display: grid; gap: 16px; }
  .roller h2 { font-size: clamp(28px, 1.4vw + 20px, 40px); margin-bottom: 8px; }
  .rolle p { margin-top: 6px; }
  @media (min-width: 900px) { .topp-sek { padding-top: calc(96px + 8vh); } .oppsett { grid-template-columns: auto 1fr; gap: 80px; } .roller { padding-top: 12px; } }
</style>
