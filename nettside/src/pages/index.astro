---
import type { ImageMetadata } from 'astro';
import Faq from '../components/Faq.astro';
import Hero from '../components/Hero.astro';
import Karusell from '../components/Karusell.astro';
import Knapp from '../components/Knapp.astro';
import Lysmork from '../components/Lysmork.astro';
import Seksjon from '../components/Seksjon.astro';
import Utsnitt from '../components/Utsnitt.astro';
import { APPLY_URL, APP_URL } from '../consts';
import { aerlig, bento, cta, demo, faq, forHvem, hero, miljo, slik } from '../innhold/forside';
import Base from '../layouts/Base.astro';

const alle = import.meta.glob<{ default: ImageMetadata }>('../assets/skjermbilder/*/*.png', { eager: true });
const bilde = (tema: 'light' | 'dark', navn: string) => alle[`../assets/skjermbilder/${tema}/${navn}.png`]!.default;
---

<Base tittel="Returapp: enkel retur og gjenbruk fra byggeplassen" beskrivelse="Meld materialer som skal ut i fem steg. Et hentefirma som dekker kommunen får beskjed, henter og bekrefter med bilde. Gratis for byggeplassen." sti="" faq={faq} app>
  <!-- 1 Hero -->
  <Hero h1={hero.h1} ingress={hero.ingress} primar={{ tekst: 'Meld henting', href: APP_URL }} lys={bilde('light', 'giver-home')} mork={bilde('dark', 'giver-home')} alt="Giverens hjem-skjerm med knappen Meld henting og kategoriene" />

  <!-- 2 Slik virker det: kort i en bane som kan dras -->
  <Seksjon h2={slik.h2} ingress="Tre skjermer, tre roller. Dra i kortene.">
    <Karusell navn="Slik virker det" kort={slik.steg.map((s) => ({ verb: s.verb, tekst: s.tekst, lys: bilde('light', s.bilde), mork: bilde('dark', s.bilde), alt: s.alt }))} />
  </Seksjon>

  <!-- 3 Demo, med lys/mørk-glider -->
  <Seksjon id="demo" eyebrow={demo.eyebrow} h2={demo.h2} ingress={demo.tekst}>
    <div data-reveal>
      <Lysmork lys={bilde('light', 'giver-home')} mork={bilde('dark', 'giver-home')} alt="Giverens hjem-skjerm i lys og mørk modus" bredde={340} />
      <p class="midt dempet liten glider-tekst">Dra i glideren. Appen følger telefonens lyse eller mørke modus.</p>
      <div class="knapper midt"><Knapp href="/demo/app.html" target="_blank">Prøv demoen</Knapp></div>
    </div>
  </Seksjon>

  <!-- 4 Funksjoner: seks kort -->
  <Seksjon h2={bento.h2}>
    <div class="rute">
      {bento.celler.map((c, i) => (
        <div data-reveal style={`--i:${i}`} class:list={['kort', { bred: c.bred }]}>
          {c.bilde && <Utsnitt lys={bilde('light', c.bilde)} mork={bilde('dark', c.bilde)} alt={c.alt ?? ''} hoyde={c.bred ? 240 : 200} />}
          <div class="kort-tekst">
            <h3>{c.tittel}</h3>
            <p class="dempet">{c.tekst}</p>
          </div>
        </div>
      ))}
    </div>
  </Seksjon>

  <!-- 5 For hvem: to fliser -->
  <Seksjon eyebrow={forHvem.eyebrow} h2={forHvem.h2}>
    <div class="to">
      {forHvem.kort.map((k, i) => (
        <div data-reveal style={`--i:${i}`} class:list={['flis', i === 0 ? 'tonet' : 'mork']}>
          <h3>{k.tittel}</h3>
          <p class="dempet">{k.tekst}</p>
          <div class="flis-bunn">
            <Knapp href={k.href}>{k.cta}</Knapp>
            <a class="pil" href={k.lenke}>{k.lenketekst} <span aria-hidden="true">→</span></a>
          </div>
        </div>
      ))}
    </div>
  </Seksjon>

  <!-- 6 Miljø: tre tall -->
  <Seksjon eyebrow={miljo.eyebrow} h2={miljo.h2}>
    <div class="tall-rad">
      {miljo.tall.map((t, i) => (
        <div data-reveal style={`--i:${i}`} class="tall-kort midt">
          <div class="tall verdi">{t.verdi}</div>
          <div class="dempet">{t.etikett}</div>
        </div>
      ))}
    </div>
    <div data-reveal class="prosa miljo-tekst midt">{miljo.tekst.map((t) => <p class="dempet">{t}</p>)}</div>
  </Seksjon>

  <!-- 7 Ærlig snakk -->
  <Seksjon>
    <div data-reveal class="prosa aerlig">
      <h2>{aerlig.h2}</h2>
      <ul class="liste">{aerlig.punkter.map((p) => <li>{p}</li>)}</ul>
    </div>
  </Seksjon>

  <!-- 8 FAQ -->
  <Seksjon h2="Spørsmål og svar">
    <div data-reveal><Faq sporsmal={faq} /></div>
  </Seksjon>

  <!-- 9 CTA -->
  <Seksjon stram>
    <div data-reveal class="flis mork cta midt">
      <h2>{cta.h2}</h2>
      <p class="ingress dempet">{cta.tekst}</p>
      <div class="knapper"><Knapp href={APP_URL}>Meld henting</Knapp><Knapp href={APPLY_URL} variant="sekundar">Bli hentefirma</Knapp></div>
    </div>
  </Seksjon>
</Base>

<style>
  .knapper { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 28px; }
  .glider-tekst { margin-top: 24px; }

  /* 4 Funksjoner: 6 kort, 2 + 3 + 1 på desktop. Brede kort viser skjermbildet i naturlig bredde (402 px) til høyre, aldri strukket. */
  .rute { display: grid; gap: 20px; }
  @media (min-width: 768px) {
    .rute { grid-template-columns: repeat(3, 1fr); }
    .rute .bred { grid-column: span 2; flex-direction: row-reverse; }
    .rute .kort:nth-child(6) { grid-column: span 3; }
    .rute .bred :global(.utsnitt) { width: 402px; max-width: 55%; height: auto; min-height: 300px; flex: none; }
    .rute .bred :global(.utsnitt img) { object-position: top center; }
    .rute .bred .kort-tekst { flex: 1; display: flex; flex-direction: column; justify-content: center; padding: 36px; }
  }

  /* 5 For hvem: to fliser, en tonet og en mørk */
  .to { display: grid; gap: 20px; }
  .to :global(.flis) { display: flex; flex-direction: column; gap: 12px; min-height: 320px; }
  .to h3 { font-size: 32px; letter-spacing: -.025em; }
  .to p { font-size: 18px; }
  .flis-bunn { display: flex; flex-wrap: wrap; align-items: center; gap: 20px; margin-top: auto; padding-top: 24px; }
  .pil { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; font-weight: 600; text-decoration: none; }
  .pil span { display: inline-block; transition: transform var(--t-ui) var(--ease-out); }
  @media (hover: hover) and (pointer: fine) { .pil:hover span { transform: translateX(4px); } }
  @media (min-width: 768px) { .to { grid-template-columns: 1fr 1fr; } }

  /* 6 Miljø: tre tall i displaystørrelse */
  .tall-rad { display: grid; gap: 32px; }
  .verdi { font-size: clamp(48px, 5vw, 80px); font-weight: 700; letter-spacing: -.04em; line-height: 1; color: var(--pri); }
  .tall-kort .dempet { margin-top: 10px; font-size: 18px; }
  .miljo-tekst { margin: 48px auto 0; }
  @media (min-width: 768px) { .tall-rad { grid-template-columns: repeat(3, 1fr); } .tall-rad :global(.tall-kort + .tall-kort) { border-left: 1px solid var(--bd); } }

  /* 7 Ærlig snakk */
  .aerlig { margin-inline: auto; }
  .aerlig h2 { margin-bottom: 28px; }
  .aerlig .liste { gap: 14px; font-size: 19px; }

  /* 9 CTA */
  .cta { display: flex; flex-direction: column; align-items: center; padding-block: clamp(48px, 8vw, 96px); }
  .cta .ingress { margin-top: 16px; }
</style>
