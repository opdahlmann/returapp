---
import type { ImageMetadata } from 'astro';
import Demo from '../components/Demo.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Faq from '../components/Faq.astro';
import Hero from '../components/Hero.astro';
import Knapp from '../components/Knapp.astro';
import Reveal from '../components/Reveal.astro';
import Seksjon from '../components/Seksjon.astro';
import Telefon from '../components/Telefon.astro';
import Utsnitt from '../components/Utsnitt.astro';
import { APPLY_URL, APP_URL } from '../consts';
import { aerlig, bento, cta, demo, faq, forHvem, hero, miljo, slik } from '../innhold/forside';
import Base from '../layouts/Base.astro';

const alle = import.meta.glob<{ default: ImageMetadata }>('../assets/skjermbilder/*/*.png', { eager: true });
const bilde = (tema: 'light' | 'dark', navn: string) => alle[`../assets/skjermbilder/${tema}/${navn}.png`]!.default;
---

<Base tittel="Returapp: enkel retur og gjenbruk fra byggeplassen" beskrivelse="Meld materialer som skal ut i fem steg. Et hentefirma som dekker kommunen får beskjed, henter og bekrefter med bilde. Gratis for byggeplassen." sti="" faq={faq} app>
  <!-- 1 Hero -->
  <Hero h1={hero.h1} ingress={hero.ingress} primar={{ tekst: 'Meld henting', href: APP_URL }} lys={bilde('light', 'giver-home')} mork={bilde('dark', 'giver-home')} alt="Giverens hjem-skjerm med knappen Meld henting og kategoriene" />

  <!-- 2 Demo -->
  <Seksjon id="demo">
    <div class="midt">
      <Eyebrow>{demo.eyebrow}</Eyebrow>
      <h2>{demo.h2}</h2>
    </div>
    <div class="demo-rad"><Demo bredde={340} /></div>
    <p class="midt dempet demo-tekst">{demo.tekst}</p>
  </Seksjon>

  <!-- 3 Slik virker det -->
  <Seksjon luft>
    <h2>{slik.h2}</h2>
    <div class="steg">
      {slik.steg.map((s, i) => (
        <Reveal i={i} class="steg-kort">
          <Telefon lys={bilde('light', s.bilde)} mork={bilde('dark', s.bilde)} alt={s.alt} bredde={260} />
          <h3>{s.verb}</h3>
          <p class="dempet">{s.tekst}</p>
        </Reveal>
      ))}
    </div>
  </Seksjon>

  <!-- 4 Bento -->
  <Seksjon>
    <h2>{bento.h2}</h2>
    <div class="bento">
      {bento.celler.map((c, i) => (
        <Reveal i={i} class:list={['celle', { bred: c.bred, tonet: !c.bilde }]}>
          {c.bilde && <Utsnitt lys={bilde('light', c.bilde)} mork={bilde('dark', c.bilde)} alt={c.alt ?? ''} hoyde={c.bred ? 220 : 180} />}
          <div class="celle-tekst">
            <h3>{c.tittel}</h3>
            <p class="dempet">{c.tekst}</p>
          </div>
        </Reveal>
      ))}
    </div>
  </Seksjon>

  <!-- 5 For hvem -->
  <Seksjon>
    <Eyebrow>{forHvem.eyebrow}</Eyebrow>
    <h2>{forHvem.h2}</h2>
    <div class="to">
      {forHvem.kort.map((k) => (
        <div class="kort flate">
          <h3>{k.tittel}</h3>
          <p class="dempet">{k.tekst}</p>
          <div class="kort-bunn">
            <Knapp href={k.href}>{k.cta}</Knapp>
            <a class="pil" href={k.lenke}>{k.lenketekst} <span aria-hidden="true">→</span></a>
          </div>
        </div>
      ))}
    </div>
  </Seksjon>

  <!-- 6 Miljø -->
  <Seksjon class="miljo-sek">
    <Eyebrow>{miljo.eyebrow}</Eyebrow>
    <h2>{miljo.h2}</h2>
    <div class="tall-rad">
      {miljo.tall.map((t) => (
        <div class="tall-kort">
          <div class="tall verdi">{t.verdi}</div>
          <div class="dempet">{t.etikett}</div>
        </div>
      ))}
    </div>
    <div class="prosa miljo-tekst">{miljo.tekst.map((t) => <p class="dempet">{t}</p>)}</div>
  </Seksjon>

  <!-- 7 Ærlig snakk -->
  <Seksjon>
    <div class="prosa">
      <h2>{aerlig.h2}</h2>
      <ul class="liste">{aerlig.punkter.map((p) => <li>{p}</li>)}</ul>
    </div>
  </Seksjon>

  <!-- 8 FAQ -->
  <Seksjon>
    <h2>Spørsmål og svar</h2>
    <div class="faq-rad"><Faq sporsmal={faq} /></div>
  </Seksjon>

  <!-- 9 CTA -->
  <Seksjon mork stram>
    <div class="cta">
      <h2>{cta.h2}</h2>
      <p class="ingress dempet">{cta.tekst}</p>
      <div class="knapper"><Knapp href={APP_URL}>Meld henting</Knapp><Knapp href={APPLY_URL} variant="sekundar">Bli hentefirma</Knapp></div>
    </div>
  </Seksjon>
</Base>

<style>
  h2 { margin-bottom: 28px; }
  .knapper { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .midt { text-align: center; }
  .midt .eyebrow { margin-inline: auto; }

  /* 2 Demo */
  .demo-rad { display: flex; justify-content: center; margin-top: 8px; }
  .demo-tekst { margin-top: 20px; }

  /* 3 Slik virker det: tre telefoner i rekke */
  .steg { display: grid; gap: 40px; }
  .steg :global(.steg-kort) { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .steg h3 { margin-top: 20px; font-size: 24px; }
  .steg p { margin-top: 8px; max-width: 32ch; }
  @media (min-width: 768px) { .steg { grid-template-columns: repeat(3, 1fr); } }

  /* 4 Bento: 6 celler, 2 + 3 + 1 på desktop */
  .bento { display: grid; gap: 16px; }
  .bento :global(.celle) { border-radius: var(--r-kort); border: 1px solid var(--bd); background: var(--sf); overflow: hidden; display: flex; flex-direction: column; transition: border-color var(--varighet-kort) var(--kurve); }
  .bento :global(.celle:hover) { border-color: var(--mu); }
  .bento :global(.tonet) { background: var(--tint); border-color: transparent; }
  .bento :global(.tonet h3) { color: var(--tint-tx); }
  .bento :global(.tonet .dempet) { color: var(--tint-tx); opacity: .85; }
  .celle-tekst { padding: 20px 22px 22px; }
  .celle-tekst p { margin-top: 6px; }
  @media (min-width: 768px) {
    .bento { grid-template-columns: repeat(3, 1fr); }
    /* Brede celler: tekst til venstre, telefonutsnitt (300 px) til høyre. */
    .bento :global(.bred) { grid-column: span 2; flex-direction: row-reverse; align-items: stretch; }
    .bento :global(.bred .utsnitt) { width: 300px; height: 320px; flex: none; border-left: 1px solid var(--bd); }
    .bento :global(.bred .utsnitt img) { width: 300px; }
    .bento :global(.bred .celle-tekst) { flex: 1; display: flex; flex-direction: column; justify-content: center; padding: 28px; }
    .bento :global(.celle:nth-child(6)) { grid-column: span 3; }
    .bento :global(.celle:nth-child(6) .utsnitt) { width: 402px; height: 340px; }
    .bento :global(.celle:nth-child(6) .utsnitt img) { width: 402px; }
  }

  /* 5 For hvem: to like kort */
  .to { display: grid; gap: 20px; }
  .kort { padding: 28px; border-radius: var(--r-kort); display: flex; flex-direction: column; gap: 10px; }
  .kort h3 { font-size: 24px; }
  .kort-bunn { display: flex; flex-wrap: wrap; align-items: center; gap: 20px; margin-top: 12px; }
  .pil { font-weight: 700; text-decoration: none; }
  .pil span { display: inline-block; transition: transform var(--varighet-kort) var(--kurve); }
  .pil:hover span { transform: translateX(4px); }
  @media (min-width: 768px) { .to { grid-template-columns: 1fr 1fr; } }

  /* 6 Miljø: tre tall */
  .tall-rad { display: grid; gap: 16px; }
  .tall-kort { padding: 24px; border-radius: var(--r-kort); border: 1px solid var(--bd); background: var(--sf); }
  .verdi { font-size: 40px; font-weight: 800; letter-spacing: -.02em; line-height: 1; color: var(--pri); }
  .tall-kort .dempet { margin-top: 8px; }
  .miljo-tekst { margin-top: 28px; }
  @media (min-width: 768px) { .tall-rad { grid-template-columns: repeat(3, 1fr); } }

  /* 7 Ærlig snakk */
  .liste { margin: 0; padding-left: 1.2em; display: grid; gap: 12px; font-size: 18px; }

  /* 9 CTA */
  .cta { text-align: center; display: flex; flex-direction: column; align-items: center; }
  .cta .knapper { justify-content: center; }
</style>
